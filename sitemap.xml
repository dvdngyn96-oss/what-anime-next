    <lastmod>2026-08-23</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- The one other distinct document on the site. Every /?id=N serves the
       root's markup; this does not, so it is worth listing. -->
  <url>
